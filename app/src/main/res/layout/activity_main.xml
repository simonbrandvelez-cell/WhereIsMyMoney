<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F7EF"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="32dp"
        android:layout_marginBottom="32dp"
        android:gravity="center_horizontal">

        <!-- LOGO -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="35dp">

            <TextView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="#087F63"
                android:gravity="center"
                android:text="💳"
                android:textSize="23sp"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Where Is"
                    android:textColor="#1D302D"
                    android:textSize="17sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="My Money"
                    android:textColor="#1D302D"
                    android:textSize="17sp"/>
            </LinearLayout>
        </LinearLayout>

        <!-- TITULO -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tu dinero, más claro."
            android:textColor="#1D302D"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Menos ¿en qué lo gasté? y más tranquilidad. Entra y empieza a llevar tus cuentas."
            android:textColor="#74817A"
            android:textSize="14sp"
            android:layout_marginBottom="28dp"/>

        <!-- NOMBRE PARA REGISTRO -->
        <EditText
            android:id="@+id/etNombre"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:backgroundTint="#087F63"
            android:hint="Nombre completo"
            android:textColor="#1D302D"
            android:textColorHint="#74817A"
            android:inputType="textPersonName"
            android:visibility="gone"
            android:layout_marginBottom="16dp"/>

        <!-- CORREO -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Correo electrónico"
            android:textColor="#1D302D"
            android:textStyle="bold"
            android:textSize="13sp"
            android:layout_marginBottom="6dp"/>

        <EditText
            android:id="@+id/etCorreo"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:backgroundTint="#087F63"
            android:hint="tu@correo.com"
            android:textColor="#1D302D"
            android:textColorHint="#74817A"
            android:inputType="textEmailAddress"
            android:singleLine="true"
            android:layout_marginBottom="18dp"/>

        <!-- CONTRASEÑA -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Contraseña"
            android:textColor="#1D302D"
            android:textStyle="bold"
            android:textSize="13sp"
            android:layout_marginBottom="6dp"/>

        <EditText
            android:id="@+id/etClave"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:backgroundTint="#087F63"
            android:hint="Escribe tu contraseña"
            android:textColor="#1D302D"
            android:textColorHint="#74817A"
            android:inputType="textPassword"
            android:singleLine="true"/>

        <!-- INGRESAR -->
        <Button
            android:id="@+id/btnIngresar"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="24dp"
            android:text="Iniciar sesión"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:backgroundTint="#087F63"
            android:textAllCaps="false"/>

        <!-- REGISTRARSE / ALTERNAR -->
        <Button
            android:id="@+id/btnRegistrar"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="12dp"
            android:text="Crear una cuenta"
            android:textColor="#087F63"
            android:textSize="14sp"
            android:backgroundTint="#E5F1EA"
            android:textAllCaps="false"/>

        <!-- ESTADO -->
        <TextView
            android:id="@+id/tvEstado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="#74817A"
            android:textSize="13sp"
            android:layout_marginTop="16dp"/>

    </LinearLayout>
</ScrollView>